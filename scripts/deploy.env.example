# Copy to the project root as .env.deploy (gitignored) and fill in real values.
# CLI flags passed to `npm run deploy -- ...` override these.

DEPLOY_HOST=example.com
DEPLOY_USER=www
DEPLOY_PATH=/var/www/anatomy

# Optional
# DEPLOY_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_DELETE=1
# Required when nginx serves the site under a URL prefix, e.g. http://host/anatomy
# BASE_PATH=/anatomy
